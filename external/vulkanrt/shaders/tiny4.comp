// Software ray tracing compute shader, for BVH4_GPU layout.
// Vulkan/GLSL translation of tiny4.hlsl.

#version 460
#extension GL_GOOGLE_include_directive : require

#include "common.glsl"

// --- resources -------------------------------------------------------------
layout( set = 0, binding = 0, rgba8 ) uniform image2D uav;                        // render target
layout( set = 0, binding = 6, std430 ) readonly buffer Bvh4Buf { vec4 bvh4Data[]; }; // tinybvh BVH4_GPU blob (nodes + tris)

#ifdef BVH4_GPU_COMPRESSED_TRIS
#define STRIDE 4u // must match the tiny_bvh.h build define
#else
#define STRIDE 3u
#endif

#define BVH4_STACK_SIZE 64 // need larger stack than BVH2.

layout( local_size_x = 8, local_size_y = 8, local_size_z = 1 ) in;

// OpenCL as_uchar4( float ): the four bytes of the bit pattern, low byte first.
vec4 as_uchar4( in float v )
{
	const uint u = floatBitsToUint( v );
	return vec4( uvec4( u, u >> 8, u >> 16, u >> 24 ) & 255u );
}

// Triangles are stored by value in the BVH4_GPU blob, one 'vertIdx' being an
// index in vec4s into that blob.
void IntersectTri4( in uint vertIdx, in vec3 O, in vec3 D, inout vec4 hit )
{
#ifdef BVH4_GPU_COMPRESSED_TRIS
	const vec4 T2 = bvh4Data[vertIdx + 2u];
	const float transS = T2.x * O.x + T2.y * O.y + T2.z * O.z + T2.w;
	const float transD = T2.x * D.x + T2.y * D.y + T2.z * D.z;
	const float d = -transS / transD;
	if (d <= 0.0f || d >= hit.x) return;
	const vec4 T0 = bvh4Data[vertIdx + 0u], T1 = bvh4Data[vertIdx + 1u];
	const vec3 I = O + d * D;
	const float u = T0.x * I.x + T0.y * I.y + T0.z * I.z + T0.w;
	const float v = T1.x * I.x + T1.y * I.y + T1.z * I.z + T1.w;
	if (u >= 0.0f && v >= 0.0f && u + v < 1.0f)
		hit = vec4( d, u, v, bvh4Data[vertIdx + 3u].w );
#else
	const vec4 vert0 = bvh4Data[vertIdx];        // .w = original triangle index
	const vec4 edge1 = bvh4Data[vertIdx + 1u];   // pre-subtracted by ConvertFrom
	const vec4 edge2 = bvh4Data[vertIdx + 2u];
	const vec3 h = cross( D, edge2.xyz );
	const float a = dot( edge1.xyz, h );
	const float f = 1.0f / a;
	const vec3 s = O - vert0.xyz;
	const float u = f * dot( s, h );
	const vec3 q = cross( s, edge1.xyz );
	const float v = f * dot( D, q );
	const float d = f * dot( edge2.xyz, q );
	const bool valid = (u >= 0.0f) && (v >= 0.0f) && (u + v <= 1.0f) &&
		(d > 0.0f) && (d < hit.x);
	hit = valid ? vec4( d, u, v, vert0.w ) : hit;
#endif
}

vec4 traverse_gpu4way( in vec3 O, in vec3 D, in vec3 rD, in float tmax )
{
	vec4 hit = vec4( tmax, 0, 0, 0 );
	uint offset = 0u, stackPtr = 0u;
	uint stack[BVH4_STACK_SIZE];
	while (true)
	{
		// vectorized 4-wide quantized aabb intersection
		const vec4 data0 = bvh4Data[offset], data1 = bvh4Data[offset + 1u];
		const vec4 data2 = bvh4Data[offset + 2u];
		uvec4 data3 = floatBitsToUint( bvh4Data[offset + 3u] );
		const vec3 bminO = (O - data0.xyz) * rD, rDe = rD * data1.xyz;
		vec4 dst4 = vec4( 0, 0, 0, 0 ), tmax4 = hit.xxxx;
		// x axis - decode, use, discard
		{
			const vec4 t1 = as_uchar4( data0.w ) * rDe.xxxx - bminO.xxxx;
			const vec4 t2 = as_uchar4( data1.w ) * rDe.xxxx - bminO.xxxx;
			dst4 = max( dst4, min( t1, t2 ) ), tmax4 = min( tmax4, max( t1, t2 ) );
		}
		// y axis
		{
			const vec4 t1 = as_uchar4( data2.x ) * rDe.yyyy - bminO.yyyy;
			const vec4 t2 = as_uchar4( data2.y ) * rDe.yyyy - bminO.yyyy;
			dst4 = max( dst4, min( t1, t2 ) ), tmax4 = min( tmax4, max( t1, t2 ) );
		}
		// z axis
		{
			const vec4 t1 = as_uchar4( data2.z ) * rDe.zzzz - bminO.zzzz;
			const vec4 t2 = as_uchar4( data2.w ) * rDe.zzzz - bminO.zzzz;
			dst4 = max( dst4, min( t1, t2 ) ), tmax4 = min( tmax4, max( t1, t2 ) );
		}
		// 1e30 == 'child not intersected'. HLSL select() becomes GLSL mix() with a
		// bvec selector, which picks the second operand where the bool is true.
		dst4 = mix( dst4, vec4( 1e30f ), greaterThan( dst4, tmax4 ) );
		// sort intersection distances, farthest first
		// bertdobbelaere.github.io/sorting_networks.html
		if (dst4.x < dst4.z) { dst4 = dst4.zyxw; data3 = data3.zyxw; }
		if (dst4.y < dst4.w) { dst4 = dst4.xwzy; data3 = data3.xwzy; }
		if (dst4.x < dst4.y) { dst4 = dst4.yxzw; data3 = data3.yxzw; }
		if (dst4.z < dst4.w) { dst4 = dst4.xywz; data3 = data3.xywz; }
		if (dst4.y < dst4.z) { dst4 = dst4.xzyw; data3 = data3.xzyw; }
		uint nextNode = 0u;
		if (dst4.x < hit.x)
		{
			if ((data3.x >> 31) == 0u)
				nextNode = data3.x; // nextNode is still 0 here, so nothing to push
			else
			{
				// leaf: tri data offset is relative to THIS node, hence '+ offset'
				const uint triCount = (data3.x >> 16) & 0x7fffu;
				for (uint i = 0u; i < triCount; i++)
					IntersectTri4( (data3.x & 0xffffu) + offset + i * STRIDE, O, D, hit );
			}
		}
		if (dst4.y < hit.x)
		{
			if ((data3.y >> 31) != 0u)
			{
				const uint triCount = (data3.y >> 16) & 0x7fffu;
				for (uint i = 0u; i < triCount; i++)
					IntersectTri4( (data3.y & 0xffffu) + offset + i * STRIDE, O, D, hit );
			}
			else
			{
				if (nextNode != 0u && stackPtr < uint( BVH4_STACK_SIZE )) stack[stackPtr++] = nextNode;
				nextNode = data3.y;
			}
		}
		if (dst4.z < hit.x)
		{
			if ((data3.z >> 31) != 0u)
			{
				const uint triCount = (data3.z >> 16) & 0x7fffu;
				for (uint i = 0u; i < triCount; i++)
					IntersectTri4( (data3.z & 0xffffu) + offset + i * STRIDE, O, D, hit );
			}
			else
			{
				if (nextNode != 0u && stackPtr < uint( BVH4_STACK_SIZE )) stack[stackPtr++] = nextNode;
				nextNode = data3.z;
			}
		}
		if (dst4.w < hit.x)
		{
			if ((data3.w >> 31) != 0u)
			{
				const uint triCount = (data3.w >> 16) & 0x7fffu;
				for (uint i = 0u; i < triCount; i++)
					IntersectTri4( (data3.w & 0xffffu) + offset + i * STRIDE, O, D, hit );
			}
			else
			{
				if (nextNode != 0u && stackPtr < uint( BVH4_STACK_SIZE )) stack[stackPtr++] = nextNode;
				nextNode = data3.w;
			}
		}
		// continue with the nearest node, or the first node on the stack
		if (nextNode != 0u) offset = nextNode;
		else
		{
			if (stackPtr == 0u) break;
			offset = stack[--stackPtr];
		}
	}
	return hit;
}

void main()
{
	const ivec2 dim = imageSize( uav );
	const uvec2 tid = gl_GlobalInvocationID.xy;
	if (tid.x >= uint( dim.x ) || tid.y >= uint( dim.y )) return; // out of bounds
	// get primary ray
	const RayData r = rayBuffer[tid.y * uint( dim.x ) + tid.x];
	const vec3 O = r.origin.xyz;
	const vec3 D = r.direction.xyz;
	const vec3 rD = safe_rcp3( D );
	// trace
	const vec4 hit = traverse_gpu4way( O, D, rD, 1e30f );
	// visualize depth
	const float t = (hit.x >= 1e30f) ? 0.0f : (1.0f - min( 1.0f, hit.x * 0.01f ));
	imageStore( uav, ivec2( tid ), vec4( t, t, t, 1 ) );
}
